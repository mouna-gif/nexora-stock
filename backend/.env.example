# ─── Backend Nexora Smart Stock AI (FastAPI + MongoDB) ────────
# Copier ce fichier en `.env` puis ajuster.

# MongoDB 7.0.11 Community — exécution directe sous Windows
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=nexora

# Sécurité JWT — OBLIGATOIRE de changer en production
JWT_SECRET=change-me-64-chars-minimum-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — origines autorisées du frontend (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Exécuter le worker de calculs longs dans le process API (dev uniquement ;
# en production utiliser `python -m app.workers.main`)
WORKER_EMBEDDED=false

# Intervalle de polling du worker (secondes)
WORKER_POLL_INTERVAL=2.0
