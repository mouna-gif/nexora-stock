# ─── Frontend Nexora Smart Stock AI ──────────────────────────────
# Copier ce fichier en `.env` puis ajuster.
# En dev sans valeur, les appels "/api/v1/..." sont proxifiés par Vite
# vers VITE_PROXY_TARGET (backend local).

# URL de base de l'API FastAPI (sans / final)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Cible du proxy de développement Vite
VITE_PROXY_TARGET=http://127.0.0.1:8000

# WebSocket temps réel (optionnel — dérivé de VITE_API_BASE_URL si absent)
# VITE_WS_URL=ws://127.0.0.1:8000
